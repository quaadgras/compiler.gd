;; Control for hybrid.wat: the same program hand-written against linear memory,
;; with a bump allocator that never frees (so it measures hand-written code with
;; a free allocator and no collector, not a usable design).
;; node   = {left i64 @0, right i64 @8}                          16 bytes
;; Entity = {pos 3xf32 @0, vel 3xf32 @12, health i32 @24, target i64 @32}  40 bytes
;; Event  = {e i64 @0, kind i32 @8}                              16 bytes
(module
  (memory (export "mem") 16384)
  (global $hp (mut i32) (i32.const 1048576))
  (global $ents (mut i32) (i32.const 0))
  (global $rng (mut i64) (i64.const 88172645463325252))
  (global $N i32 (i32.const 20000))
  (global $verts i32 (i32.const 65536))

  (func $alloc (param $n i32) (result i32)
    (local $p i32)
    (local.set $p (global.get $hp))
    (global.set $hp (i32.add (local.get $p) (local.get $n)))
    (local.get $p))
  (func (export "reset") (global.set $hp (i32.const 1048576)))

  (func $bottomUp (param $d i32) (result i32)
    (local $p i32) (local $l i32)
    (if (result i32) (i32.eqz (local.get $d))
      (then
        ;; a leaf: reused memory is not zero
        (local.set $p (call $alloc (i32.const 16)))
        (i64.store (local.get $p) (i64.const 0))
        (i64.store offset=8 (local.get $p) (i64.const 0))
        (local.get $p))
      (else
        (local.set $l (call $bottomUp (i32.sub (local.get $d) (i32.const 1))))
        (local.set $d (call $bottomUp (i32.sub (local.get $d) (i32.const 1))))
        (local.set $p (call $alloc (i32.const 16)))
        (i64.store (local.get $p) (i64.extend_i32_u (local.get $l)))
        (i64.store offset=8 (local.get $p) (i64.extend_i32_u (local.get $d)))
        (local.get $p))))
  (func $check (param $p i32) (result i32)
    (local $l i32)
    (local.set $l (i32.wrap_i64 (i64.load (local.get $p))))
    (if (result i32) (i32.eqz (local.get $l))
      (then (i32.const 1))
      (else (i32.add (i32.const 1)
        (i32.add (call $check (local.get $l))
                 (call $check (i32.wrap_i64 (i64.load offset=8 (local.get $p)))))))))
  ;; trees(max), freeing nothing except by resetting the heap after each depth
  (func (export "trees") (param $max i32) (result i32)
    (local $sum i32) (local $long i32) (local $d i32) (local $iters i32) (local $i i32) (local $mark i32)
    (local.set $sum (call $check (call $bottomUp (i32.add (local.get $max) (i32.const 1)))))
    (local.set $long (call $bottomUp (local.get $max)))
    (local.set $mark (global.get $hp))
    (local.set $d (i32.const 4))
    (block $done
      (loop $dl
        (br_if $done (i32.gt_s (local.get $d) (local.get $max)))
        (local.set $iters (i32.shl (i32.const 1) (i32.add (i32.sub (local.get $max) (local.get $d)) (i32.const 4))))
        (local.set $i (i32.const 0))
        (loop $il
          (local.set $sum (i32.add (local.get $sum) (call $check (call $bottomUp (local.get $d)))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br_if $il (i32.lt_s (local.get $i) (local.get $iters))))
        (global.set $hp (local.get $mark))
        (local.set $d (i32.add (local.get $d) (i32.const 2)))
        (br $dl)))
    (i32.add (local.get $sum) (call $check (local.get $long))))

  (func $next (result i64)
    (local $x i64)
    (local.set $x (global.get $rng))
    (local.set $x (i64.xor (local.get $x) (i64.shl (local.get $x) (i64.const 13))))
    (local.set $x (i64.xor (local.get $x) (i64.shr_u (local.get $x) (i64.const 7))))
    (local.set $x (i64.xor (local.get $x) (i64.shl (local.get $x) (i64.const 17))))
    (global.set $rng (local.get $x))
    (local.get $x))
  (func $newEntity (param $j i32) (param $target i32) (result i32)
    (local $p i32)
    (local.set $p (call $alloc (i32.const 40)))
    (f32.store (local.get $p) (f32.convert_i32_s (i32.rem_s (local.get $j) (i32.const 100))))
    (f32.store offset=4 (local.get $p) (f32.convert_i32_s (i32.rem_s (local.get $j) (i32.const 37))))
    (f32.store offset=8 (local.get $p) (f32.convert_i32_s (i32.rem_s (local.get $j) (i32.const 11))))
    (f32.store offset=12 (local.get $p) (f32.const 0.1))
    (f32.store offset=16 (local.get $p) (f32.const 0.2))
    (f32.store offset=20 (local.get $p) (f32.const 0.3))
    (i32.store offset=24 (local.get $p) (i32.const 100))
    (i64.store offset=32 (local.get $p) (i64.extend_i32_u (local.get $target)))
    (local.get $p))
  (func (export "setup")
    (local $i i32) (local $a i32)
    (local.set $a (call $alloc (i32.mul (global.get $N) (i32.const 8))))
    (loop $l
      (i64.store (i32.add (local.get $a) (i32.shl (local.get $i) (i32.const 3)))
        (i64.extend_i32_u (call $newEntity (local.get $i) (i32.const 0))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_s (local.get $i) (global.get $N))))
    (local.set $i (i32.const 0))
    (loop $l2
      (i64.store offset=32
        (i32.wrap_i64 (i64.load (i32.add (local.get $a) (i32.shl (local.get $i) (i32.const 3)))))
        (i64.load (i32.add (local.get $a)
          (i32.shl (i32.rem_s (i32.add (i32.mul (local.get $i) (i32.const 7)) (i32.const 1)) (global.get $N)) (i32.const 3)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l2 (i32.lt_s (local.get $i) (global.get $N))))
    (global.set $ents (local.get $a)))
  (func (export "frame") (param $f i32) (result f32)
    (local $i i32) (local $n i32) (local $k i32) (local $j i32) (local $ti i32) (local $vp i32)
    (local $a i32) (local $events i32) (local $e i32) (local $t i32) (local $ev i32)
    (local.set $a (global.get $ents))
    (local.set $events (call $alloc (i32.const 16000)))
    (loop $l
      (if (i32.ge_u (local.get $i) (global.get $N)) (then (unreachable)))
      (local.set $e (i32.wrap_i64 (i64.load (i32.add (local.get $a) (i32.shl (local.get $i) (i32.const 3))))))
      (f32.store (local.get $e) (f32.add (f32.load (local.get $e)) (f32.mul (f32.load offset=12 (local.get $e)) (f32.const 0.016))))
      (f32.store offset=4 (local.get $e) (f32.add (f32.load offset=4 (local.get $e)) (f32.mul (f32.load offset=16 (local.get $e)) (f32.const 0.016))))
      (f32.store offset=8 (local.get $e) (f32.add (f32.load offset=8 (local.get $e)) (f32.mul (f32.load offset=20 (local.get $e)) (f32.const 0.016))))
      (local.set $t (i32.wrap_i64 (i64.load offset=32 (local.get $e))))
      (if (i32.eqz (local.get $t)) (then (unreachable)))
      (f32.store offset=12 (local.get $e) (f32.add (f32.load offset=12 (local.get $e))
        (f32.mul (f32.sub (f32.load (local.get $t)) (f32.load (local.get $e))) (f32.const 0.001))))
      (f32.store offset=16 (local.get $e) (f32.add (f32.load offset=16 (local.get $e))
        (f32.mul (f32.sub (f32.load offset=4 (local.get $t)) (f32.load offset=4 (local.get $e))) (f32.const 0.001))))
      (f32.store offset=20 (local.get $e) (f32.add (f32.load offset=20 (local.get $e))
        (f32.mul (f32.sub (f32.load offset=8 (local.get $t)) (f32.load offset=8 (local.get $e))) (f32.const 0.001))))
      (local.set $vp (i32.add (global.get $verts) (i32.mul (local.get $i) (i32.const 12))))
      (f32.store (local.get $vp) (f32.load (local.get $e)))
      (f32.store offset=4 (local.get $vp) (f32.load offset=4 (local.get $e)))
      (f32.store offset=8 (local.get $vp) (f32.load offset=8 (local.get $e)))
      (if (i32.eq (i32.rem_s (local.get $i) (i32.const 10)) (i32.rem_s (local.get $f) (i32.const 10)))
        (then
          (local.set $ev (call $alloc (i32.const 16)))
          (i64.store (local.get $ev) (i64.extend_i32_u (local.get $e)))
          (i32.store offset=8 (local.get $ev) (local.get $i))
          (i64.store (i32.add (local.get $events) (i32.shl (local.get $n) (i32.const 3))) (i64.extend_i32_u (local.get $ev)))
          (local.set $n (i32.add (local.get $n) (i32.const 1)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_s (local.get $i) (global.get $N))))
    (local.set $i (i32.const 0))
    (block $ed
      (loop $el
        (br_if $ed (i32.ge_s (local.get $i) (local.get $n)))
        (local.set $ev (i32.wrap_i64 (i64.load (i32.add (local.get $events) (i32.shl (local.get $i) (i32.const 3))))))
        (local.set $e (i32.wrap_i64 (i64.load (local.get $ev))))
        (i32.store offset=24 (local.get $e)
          (i32.add (i32.load offset=24 (local.get $e)) (i32.and (i32.load offset=8 (local.get $ev)) (i32.const 1))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $el)))
    (loop $rl
      (local.set $j (i32.wrap_i64 (i64.rem_u (call $next) (i64.const 20000))))
      (local.set $ti (i32.wrap_i64 (i64.rem_u (call $next) (i64.const 20000))))
      (i64.store (i32.add (local.get $a) (i32.shl (local.get $j) (i32.const 3)))
        (i64.extend_i32_u (call $newEntity (local.get $j)
          (i32.wrap_i64 (i64.load (i32.add (local.get $a) (i32.shl (local.get $ti) (i32.const 3))))))))
      (local.set $k (i32.add (local.get $k) (i32.const 1)))
      (br_if $rl (i32.lt_s (local.get $k) (i32.const 200))))
    (f32.load (i32.add (global.get $verts)
      (i32.shl (i32.rem_s (i32.mul (local.get $f) (i32.const 7)) (i32.const 60000)) (i32.const 2)))))
  (func (export "health") (result i64)
    (local $i i32) (local $h i64)
    (loop $l
      (local.set $h (i64.add (local.get $h) (i64.extend_i32_s
        (i32.load offset=24 (i32.wrap_i64 (i64.load (i32.add (global.get $ents) (i32.shl (local.get $i) (i32.const 3)))))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_s (local.get $i) (global.get $N))))
    (local.get $h))
)
