;; goprog/main.go hand-translated to the wasm GC hybrid design (doc/gd/wasm-gc.md):
;; - one typed wasm struct per Go object, with a header: Go type id and object id
;; - a pointer is one reference of type (ref null struct), cast when dereferenced
;;   (an interior pointer would be a box; this program takes none)
;; - []*T is a wasm GC array of references
;; - []float32 lives in linear memory
(module
  (memory (export "mem") 16)
  (type $node (struct (field i32) (field (mut i32))
    (field $left (mut (ref null struct))) (field $right (mut (ref null struct)))))
  (type $Entity (struct (field i32) (field (mut i32))
    (field $px (mut f32)) (field $py (mut f32)) (field $pz (mut f32))
    (field $vx (mut f32)) (field $vy (mut f32)) (field $vz (mut f32))
    (field $health (mut i32)) (field $target (mut (ref null struct)))))
  (type $Event (struct (field i32) (field (mut i32)) (field $e (ref null struct)) (field $kind i32)))
  (type $ptrs (array (mut (ref null struct))))

  (global $ents (mut (ref null $ptrs)) (ref.null $ptrs))
  (global $rng (mut i64) (i64.const 88172645463325252))
  (global $N i32 (i32.const 20000))
  (global $verts i32 (i32.const 65536))

  ;; ---- trees ----
  (func $bottomUp (param $d i32) (result (ref null struct))
    (if (result (ref null struct)) (i32.eqz (local.get $d))
      (then (struct.new $node (i32.const 1) (i32.const 0) (ref.null struct) (ref.null struct)))
      (else (struct.new $node (i32.const 1) (i32.const 0)
        (call $bottomUp (i32.sub (local.get $d) (i32.const 1)))
        (call $bottomUp (i32.sub (local.get $d) (i32.const 1)))))))
  (func $check (param $p (ref null struct)) (result i32)
    (local $n (ref null $node))
    (local.set $n (ref.cast (ref null $node) (local.get $p)))
    (if (result i32) (ref.is_null (struct.get $node $left (local.get $n)))
      (then (i32.const 1))
      (else (i32.add (i32.const 1)
        (i32.add (call $check (struct.get $node $left (local.get $n)))
                 (call $check (struct.get $node $right (local.get $n))))))))
  (func (export "trees") (param $max i32) (result i32)
    (local $sum i32) (local $long (ref null struct)) (local $d i32) (local $iters i32) (local $i i32)
    (local.set $sum (call $check (call $bottomUp (i32.add (local.get $max) (i32.const 1)))))
    (local.set $long (call $bottomUp (local.get $max)))
    (local.set $d (i32.const 4))
    (block $done
      (loop $dl
        (br_if $done (i32.gt_s (local.get $d) (local.get $max)))
        (local.set $iters (i32.shl (i32.const 1) (i32.add (i32.sub (local.get $max) (local.get $d)) (i32.const 4))))
        (local.set $i (i32.const 0))
        (loop $il
          (local.set $sum (i32.add (local.get $sum) (call $check (call $bottomUp (local.get $d)))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br_if $il (i32.lt_s (local.get $i) (local.get $iters))))
        (local.set $d (i32.add (local.get $d) (i32.const 2)))
        (br $dl)))
    (i32.add (local.get $sum) (call $check (local.get $long))))

  ;; ---- frames ----
  (func $next (result i64)
    (local $x i64)
    (local.set $x (global.get $rng))
    (local.set $x (i64.xor (local.get $x) (i64.shl (local.get $x) (i64.const 13))))
    (local.set $x (i64.xor (local.get $x) (i64.shr_u (local.get $x) (i64.const 7))))
    (local.set $x (i64.xor (local.get $x) (i64.shl (local.get $x) (i64.const 17))))
    (global.set $rng (local.get $x))
    (local.get $x))
  (func $newEntity (param $j i32) (param $target (ref null struct)) (result (ref null struct))
    (struct.new $Entity (i32.const 2) (i32.const 0)
      (f32.convert_i32_s (i32.rem_s (local.get $j) (i32.const 100)))
      (f32.convert_i32_s (i32.rem_s (local.get $j) (i32.const 37)))
      (f32.convert_i32_s (i32.rem_s (local.get $j) (i32.const 11)))
      (f32.const 0.1) (f32.const 0.2) (f32.const 0.3)
      (i32.const 100) (local.get $target)))
  (func (export "setup")
    (local $i i32) (local $a (ref null $ptrs))
    (local.set $a (array.new_default $ptrs (global.get $N)))
    (loop $l
      (array.set $ptrs (local.get $a) (local.get $i) (call $newEntity (local.get $i) (ref.null struct)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_s (local.get $i) (global.get $N))))
    (local.set $i (i32.const 0))
    (loop $l2
      (struct.set $Entity $target
        (ref.cast (ref null $Entity) (array.get $ptrs (local.get $a) (local.get $i)))
        (array.get $ptrs (local.get $a)
          (i32.rem_s (i32.add (i32.mul (local.get $i) (i32.const 7)) (i32.const 1)) (global.get $N))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l2 (i32.lt_s (local.get $i) (global.get $N))))
    (global.set $ents (local.get $a)))
  (func (export "frame") (param $f i32) (result f32)
    (local $i i32) (local $n i32) (local $k i32) (local $j i32) (local $ti i32) (local $vp i32)
    (local $a (ref null $ptrs)) (local $events (ref null $ptrs))
    (local $e (ref null $Entity)) (local $t (ref null $Entity)) (local $ev (ref null $Event))
    (local.set $a (global.get $ents))
    (local.set $events (array.new_default $ptrs (i32.const 2000)))
    (loop $l
      (local.set $e (ref.cast (ref null $Entity) (array.get $ptrs (local.get $a) (local.get $i))))
      (struct.set $Entity $px (local.get $e) (f32.add (struct.get $Entity $px (local.get $e)) (f32.mul (struct.get $Entity $vx (local.get $e)) (f32.const 0.016))))
      (struct.set $Entity $py (local.get $e) (f32.add (struct.get $Entity $py (local.get $e)) (f32.mul (struct.get $Entity $vy (local.get $e)) (f32.const 0.016))))
      (struct.set $Entity $pz (local.get $e) (f32.add (struct.get $Entity $pz (local.get $e)) (f32.mul (struct.get $Entity $vz (local.get $e)) (f32.const 0.016))))
      (local.set $t (ref.cast (ref null $Entity) (struct.get $Entity $target (local.get $e))))
      (struct.set $Entity $vx (local.get $e) (f32.add (struct.get $Entity $vx (local.get $e))
        (f32.mul (f32.sub (struct.get $Entity $px (local.get $t)) (struct.get $Entity $px (local.get $e))) (f32.const 0.001))))
      (struct.set $Entity $vy (local.get $e) (f32.add (struct.get $Entity $vy (local.get $e))
        (f32.mul (f32.sub (struct.get $Entity $py (local.get $t)) (struct.get $Entity $py (local.get $e))) (f32.const 0.001))))
      (struct.set $Entity $vz (local.get $e) (f32.add (struct.get $Entity $vz (local.get $e))
        (f32.mul (f32.sub (struct.get $Entity $pz (local.get $t)) (struct.get $Entity $pz (local.get $e))) (f32.const 0.001))))
      (local.set $vp (i32.add (global.get $verts) (i32.mul (local.get $i) (i32.const 12))))
      (f32.store (local.get $vp) (struct.get $Entity $px (local.get $e)))
      (f32.store offset=4 (local.get $vp) (struct.get $Entity $py (local.get $e)))
      (f32.store offset=8 (local.get $vp) (struct.get $Entity $pz (local.get $e)))
      (if (i32.eq (i32.rem_s (local.get $i) (i32.const 10)) (i32.rem_s (local.get $f) (i32.const 10)))
        (then
          (array.set $ptrs (local.get $events) (local.get $n)
            (struct.new $Event (i32.const 3) (i32.const 0) (local.get $e) (local.get $i)))
          (local.set $n (i32.add (local.get $n) (i32.const 1)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_s (local.get $i) (global.get $N))))
    (local.set $i (i32.const 0))
    (block $ed
      (loop $el
        (br_if $ed (i32.ge_s (local.get $i) (local.get $n)))
        (local.set $ev (ref.cast (ref null $Event) (array.get $ptrs (local.get $events) (local.get $i))))
        (local.set $e (ref.cast (ref null $Entity) (struct.get $Event $e (local.get $ev))))
        (struct.set $Entity $health (local.get $e)
          (i32.add (struct.get $Entity $health (local.get $e)) (i32.and (struct.get $Event $kind (local.get $ev)) (i32.const 1))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $el)))
    (loop $rl
      (local.set $j (i32.wrap_i64 (i64.rem_u (call $next) (i64.const 20000))))
      (local.set $ti (i32.wrap_i64 (i64.rem_u (call $next) (i64.const 20000))))
      (array.set $ptrs (local.get $a) (local.get $j)
        (call $newEntity (local.get $j) (array.get $ptrs (local.get $a) (local.get $ti))))
      (local.set $k (i32.add (local.get $k) (i32.const 1)))
      (br_if $rl (i32.lt_s (local.get $k) (i32.const 200))))
    (f32.load (i32.add (global.get $verts)
      (i32.shl (i32.rem_s (i32.mul (local.get $f) (i32.const 7)) (i32.const 60000)) (i32.const 2)))))
  (func (export "health") (result i64)
    (local $i i32) (local $h i64)
    (loop $l
      (local.set $h (i64.add (local.get $h) (i64.extend_i32_s
        (struct.get $Entity $health (ref.cast (ref null $Entity) (array.get $ptrs (global.get $ents) (local.get $i)))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_s (local.get $i) (global.get $N))))
    (local.get $h))
)
