#!/bin/sh
# ccview: serve C next to the Go cmd/cc writes for it, rebuilding cmd/cc
# from this tree on every translation. Arguments go to the server
# (-addr, extra directories or files to offer).
root=$(cd "$(dirname "$0")/../.." && pwd)
export PATH="$PATH:/usr/local/bin:/usr/bin:/usr/sbin:$root/bin"
cd "$root/misc/ccview" && exec go run . -root "$root" "$@"
