# Programs need WebAssembly GC and JSPI (unless they are built with
# GOWASM=linear): node runs them, or a browser if GOWASIRUNTIME names
# one.
case ",$GOWASM," in
	*,linear,*) ;;
	*)
		case "$GOWASIRUNTIME" in
			chromium | firefox)
				NODE_OPTIONS= exec node --disable-warning=ExperimentalWarning "$(dirname "$0")/wasm_gc_browser_exec.mjs" "$1" "${@:2}"
				;;
		esac
		NODE_OPTIONS= exec node --disable-warning=ExperimentalWarning --stack-size=4000 "$(dirname "$0")/wasm_gc_node.mjs" "$1" "${@:2}"
		;;
esac

case "$GOWASIRUNTIME" in
	"wasmedge")
		exec wasmedge --dir=/ --env PWD="$PWD" --env PATH="$PATH" ${GOWASIRUNTIMEARGS:-} "$1" "${@:2}"
		;;
	"wasmer")
		exec wasmer run --dir=/ --env PWD="$PWD" --env PATH="$PATH" ${GOWASIRUNTIMEARGS:-} "$1" -- "${@:2}"
		;;
	"wazero")
		exec wazero run -mount /:/ -env-inherit -cachedir "${TMPDIR:-/tmp}"/wazero ${GOWASIRUNTIMEARGS:-} "$1" "${@:2}"
		;;
	"wasmtime" | "")
		exec wasmtime run --dir=/ --env PWD="$PWD" --env PATH="$PATH" -W max-wasm-stack=8388608 ${GOWASIRUNTIMEARGS:-} "$1" "${@:2}"
		;;
	*)
		echo "Unknown Go WASI runtime specified: $GOWASIRUNTIME"
		exit 1
		;;
esac
