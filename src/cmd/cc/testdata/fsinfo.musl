wordexp [a b  c]: 0 3: <a> <b> <c>
wordexp [$FSV]: 0 2: <one> <two>
wordexp ["$FSV"]: 0 1: <one two>
wordexp [${FSV}x]: 0 2: <one> <twox>
wordexp [x$FSE y "$FSE"]: 0 3: <x> <y> <>
wordexp ['$FSV' "a b" c\ d]: 0 3: <$FSV> <a b> <c d>
wordexp [~ ~/x a~]: 0 3: </home/test> </home/test/x> <a~>
wordexp [${FSU:-def} ${FSV:+alt} ${FSE:-empty} ${FSE-unset} ${#FSV}]: 0 4: <def> <alt> <empty> <7>
wordexp [${FSP%.c} ${FSP#*/} ${FSP##*/} ${FSP%%/*} ${FSP%/*}]: 0 5: <dir/sub/file> <sub/file.c> <file.c> <dir> <dir/sub>
wordexp [$((1+2*3)) $((FSN*2)) $(((7-1)/2)) $((-5%3)) $((1<<4|1))]: 0 5: <7> <42> <3> <-2> <17>
wordexp [g*.txt]: 0 2: <g1.txt> <g2.txt>
wordexp [*.none 'g*' g\*]: 0 3: <*.none> <g*> <g*>
wordexp [.g*]: 0 1: <.g3.txt>
wordexp [$(echo hi there) "$(echo a  b)" `echo x`]: 0 4: <hi> <there> <a b> <x>
wordexp ["abc]: 5
wordexp ['abc]: 5
wordexp [$(echo hi)]: 4
wordexp [`echo hi`]: 4
wordexp [${FSV]: 5
wordexp [$FSU]: 0 0:
wordexp [x${FSU}y]: 0 1: <xy>
